rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }
    function isHost(roomId) {
      return request.auth != null
        && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }
    function isMember(roomId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      // A room code allows a signed-in player to look up one room, but clients
      // cannot list every room in the database.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby';
      allow update, delete: if isHost(roomId);

      match /players/{playerId} {
        // Before joining, authenticated users may inspect the player list of a
        // lobby so the app can enforce its 20-player limit.
        allow read: if isMember(roomId) || isHost(roomId)
          || (request.auth != null && get(roomPath(roomId)).data.status == 'lobby');
        allow create: if request.auth != null
          && request.auth.uid == playerId
          && get(roomPath(roomId)).data.status == 'lobby';
        // A player may change their own name. Only the host may update scores.
        allow update: if isHost(roomId)
          || (request.auth != null
            && request.auth.uid == playerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
        allow delete: if isHost(roomId)
          || (request.auth != null && request.auth.uid == playerId);
      }

      match /rounds/{roundId} {
        allow read: if isMember(roomId) || isHost(roomId);
        allow create, update, delete: if isHost(roomId);

        match /answer/{answerId} {
          // The answer coordinates are readable only by the room host until
          // the host publishes the round results.
          allow read, write: if isHost(roomId);
        }

        match /guesses/{playerId} {
          allow read: if isMember(roomId) || isHost(roomId);
          allow create, update: if request.auth != null
            && request.auth.uid == playerId
            && get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data.status == 'playing';
          allow delete: if isHost(roomId)
            || (request.auth != null && request.auth.uid == playerId);
        }

        match /results/{playerId} {
          allow read: if isMember(roomId) || isHost(roomId);
          allow create, update, delete: if isHost(roomId);
        }
      }
    }
  }
}
